FROM oleglod/cafe-crypto-backend:build-oqs AS source

FROM debian:trixie-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libz1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=source /usr/bin/openssl /usr/bin/openssl
COPY --from=source /usr/lib/*/libssl.so* /usr/lib/
COPY --from=source /usr/lib/*/libcrypto.so* /usr/lib/
COPY --from=source /opt/liboqs/lib /opt/liboqs/lib
COPY --from=source /etc/ssl/openssl.cnf /etc/ssl/openssl.cnf

# Copy wrapper script from build context
COPY scripts/openssl-wrapper.sh /usr/local/bin/openssl-wrapper
RUN chmod +x /usr/local/bin/openssl-wrapper

# Copy ossl-modules using mount to access source filesystem
# Detect architecture and copy to correct location, then create profile script
RUN --mount=from=source,source=/usr/lib,target=/mnt/source/usr/lib \
    ARCH=$(dpkg-architecture -q DEB_HOST_GNU_TYPE 2>/dev/null || \
    (ARCH_UNAME=$(uname -m); \
     case "$ARCH_UNAME" in \
       x86_64) echo "x86_64-linux-gnu" ;; \
       aarch64|arm64) echo "aarch64-linux-gnu" ;; \
       *) echo "x86_64-linux-gnu" ;; \
     esac)) && \
    echo "Detected architecture: $ARCH" && \
    mkdir -p /usr/lib/$ARCH/ossl-modules && \
    # Find and copy ossl-modules from source
    for dir in /mnt/source/usr/lib/*/ossl-modules; do \
        if [ -d "$dir" ] && [ -f "$dir/oqsprovider.so" ]; then \
            echo "Copying from $dir to /usr/lib/$ARCH/ossl-modules/" && \
            cp -r "$dir"/* /usr/lib/$ARCH/ossl-modules/ && \
            break; \
        fi; \
    done && \
    # Verify modules were copied
    ls -la /usr/lib/$ARCH/ossl-modules/ && \
    # Create profile script
    echo "export OPENSSL_MODULES=/usr/lib/$ARCH/ossl-modules" > /etc/profile.d/openssl-oqs.sh && \
    chmod +x /etc/profile.d/openssl-oqs.sh

# Set environment variables for OpenSSL with OQS provider
# These are required for all containers using this image
ENV OPENSSL_CONF=/etc/ssl/openssl.cnf
ENV LD_LIBRARY_PATH=/opt/liboqs/lib
# OPENSSL_MODULES: The wrapper script will detect architecture at runtime
# For non-interactive use, this default may need to be overridden
# The openssl-wrapper script handles this automatically
ENV OPENSSL_MODULES=/usr/lib/x86_64-linux-gnu/ossl-modules

# Use the wrapper script as entrypoint to ensure correct OPENSSL_MODULES
ENTRYPOINT ["/usr/local/bin/openssl-wrapper"]
CMD ["version"]
